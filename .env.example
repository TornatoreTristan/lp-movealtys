# Google Tag Manager container. The production id lives in src/lib/tracking.ts
# (DEFAULT_GTM_ID) — a container id is public, so it is not configuration.
#
# Set this variable only to override that default:
#   PUBLIC_GTM_ID=GTM-KDVSW56S   measure during `astro dev` too, e.g. to work on the banner
#   PUBLIC_GTM_ID=               build the site with no banner, no container, no cookie
#
# See movealtys-config-gtm-ga4.md for what the container is expected to relay.
PUBLIC_GTM_ID=
