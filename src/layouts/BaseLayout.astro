---
import '@fontsource-variable/plus-jakarta-sans'
import '../styles/global.css'

import { LOCALES, LOCALE_META, localizePath, type Locale } from '../i18n/config'
import { useContent } from '../i18n/content'
import { ANALYTICS_ENABLED, getPageContext, type PageType } from '../lib/tracking'
import { robotsDirective } from '../lib/seo'
import Gtm from '../components/analytics/Gtm.astro'
import ConsentBanner from '../components/analytics/ConsentBanner.astro'
import Banner from '../components/Banner.astro'
import Header from '../components/Header.astro'
import Footer from '../components/Footer.astro'

interface Props {
  locale: Locale
  title?: string
  description?: string
  /** Path without the locale prefix, e.g. '' for the home page or 'legal'. */
  path?: string
  /** Withholds this page's links too. The site-wide policy lives in `lib/seo.ts`. */
  noindex?: boolean
  /** Overrides the type derived from `path` — only the 404 page needs it. */
  pageType?: PageType
  jsonLd?: Record<string, unknown>[]
}

const { locale, title, description, path = '', noindex = false, pageType, jsonLd = [] } = Astro.props

// Published on <body> so the tagging layer reads page context without a second source of truth.
const page = getPageContext(path, pageType)
const robots = robotsDirective(noindex)
const t = useContent(locale)

const site = Astro.site ?? new URL('https://lp.movealtys.com')
const pageTitle = title ?? t.meta.title
const pageDescription = description ?? t.meta.description
const canonical = new URL(localizePath(locale, path), site)
const ogImage = new URL(`/img/og-${locale}.png`, site)
---

<!doctype html>
<html lang={LOCALE_META[locale].bcp47} class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    {ANALYTICS_ENABLED && <Gtm />}

    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical.href} />
    {robots && <meta name="robots" content={robots} />}

    {
      LOCALES.map((code) => (
        <link rel="alternate" hreflang={code} href={new URL(localizePath(code, path), site).href} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={new URL(localizePath('fr', path), site).href} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="MoveAltys" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:alt" content={t.meta.ogAlt} />
    <meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
    {
      LOCALES.filter((code) => code !== locale).map((code) => (
        <meta property="og:locale:alternate" content={LOCALE_META[code].ogLocale} />
      ))
    }

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImage.href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#327eff" />

    {
      jsonLd.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />
      ))
    }
  </head>

  <body data-page-type={page.pageType} data-segment={page.segment} data-page-lang={locale}>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:rounded-full focus:bg-ink-950 focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-white"
    >
      {t.nav.skipToContent}
    </a>

    <Banner locale={locale} />
    <Header locale={locale} />

    <main id="main">
      <slot />
    </main>

    <Footer locale={locale} />

    {ANALYTICS_ENABLED && <ConsentBanner locale={locale} />}

    <script>
      import { initReveal } from '../scripts/reveal'
      import { initAnalytics } from '../scripts/analytics'

      initReveal()
      initAnalytics()
    </script>
  </body>
</html>
