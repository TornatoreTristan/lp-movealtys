---
import { DEFAULT_LOCALE } from '../i18n/config'
import BaseLayout from '../layouts/BaseLayout.astro'
import Button from '../components/ui/Button.astro'

const locale = DEFAULT_LOCALE
---

<BaseLayout locale={locale} title="Page introuvable · MoveAltys" pageType="404" noindex>
  <div class="container-page flex min-h-[60vh] flex-col items-center justify-center gap-6 py-24 text-center">
    <span class="text-6xl font-black text-brand-500">404</span>
    <h1 class="text-h2 font-extrabold text-ink-950 text-balance">
      Cette page a pris un mauvais itinéraire.
    </h1>
    <p class="max-w-md text-muted">
      La page demandée n’existe pas ou a été déplacée. / The page you requested does not exist.
    </p>
    <div class="flex flex-col gap-3 sm:flex-row">
      <Button href="/fr/" size="lg">Retour à l’accueil</Button>
      <Button href="/en/" variant="secondary" size="lg">Back to home</Button>
    </div>
  </div>
</BaseLayout>
