---
import { localizePath, type Locale } from '../i18n/config'
import { useContent, APP_URLS, CONTACT, type SegmentContent } from '../i18n/content'
import { PLAN_SLUGS } from '../lib/tracking'
import Section from './ui/Section.astro'
import SectionHeading from './ui/SectionHeading.astro'
import Button from './ui/Button.astro'
import RouteVisual from './ui/RouteVisual.astro'

interface Props {
  locale: Locale
  /** Copy block for this audience, e.g. `t.independents` or `t.tpe`. */
  segment: SegmentContent
  /** Index into `t.pricing.plans` of the plan this audience should see. */
  planIndex: number
}

const { locale, segment: p, planIndex } = Astro.props
const t = useContent(locale)

// The plan card reads the pricing data rather than restating it, so a price change lands here too.
const plan = t.pricing.plans[planIndex]
---

  <!-- Hero -->
  <section class="relative overflow-hidden bg-white pt-14 pb-20 sm:pt-20 sm:pb-28">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="absolute -top-40 -right-24 size-[36rem] rounded-full bg-brand-500/12 blur-3xl sm:-right-10"></div>
      <div class="absolute -bottom-56 -left-40 size-[32rem] rounded-full bg-ink-950/8 blur-3xl"></div>
    </div>

    <div class="container-page grid items-center gap-14 lg:grid-cols-[1.05fr_1fr] lg:gap-16">
      <div class="flex flex-col items-start gap-7">
        <span
          class="inline-flex items-center gap-2 rounded-full bg-brand-50 px-3.5 py-1.5 text-xs font-semibold tracking-wide text-brand-700 ring-1 ring-brand-100"
          data-reveal
        >
          <span class="size-1.5 rounded-full bg-brand-500"></span>
          {p.hero.eyebrow}
        </span>

        <h1 class="text-display font-extrabold text-ink-950 text-balance" data-reveal>
          {p.hero.titleLine1}<br />
          <span class="bg-gradient-to-r from-brand-600 via-brand-500 to-brand-400 bg-clip-text text-transparent"
            >{p.hero.titleLine2}</span
          >
        </h1>

        <p class="max-w-xl text-lg leading-relaxed text-muted text-pretty" data-reveal>{p.hero.lead}</p>

        <div class="flex flex-col items-start gap-3" data-reveal>
          <Button
            href={APP_URLS.register}
            size="lg"
            track="cta_signup_click"
            ctaLocation="segment_hero"
            ctaDestination="register"
          >
            {p.hero.cta}
          </Button>
          <p class="flex items-center gap-2 text-sm text-ink-500">
            <svg viewBox="0 0 20 20" fill="currentColor" class="size-4 text-mint-500" aria-hidden="true">
              <path
                fill-rule="evenodd"
                d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z"
                clip-rule="evenodd"></path>
            </svg>
            {p.hero.reassurance}
          </p>
        </div>
      </div>

      <div class="relative" data-reveal>
        <RouteVisual locale={locale} />
      </div>
    </div>
  </section>

  <!-- Pains -->
  <Section id="pains" tone="white">
    <SectionHeading eyebrow={p.pains.eyebrow} title={p.pains.title} lead={p.pains.lead} />

    <div class="mt-14 grid gap-6 md:grid-cols-3">
      {
        p.pains.items.map((item, index) => (
          <article
            class="relative flex flex-col gap-3 rounded-3xl border border-ink-100 bg-white p-7 transition duration-300 hover:border-brand-200 hover:shadow-card"
            data-reveal
          >
            <span class="text-sm font-black text-brand-200 tabular-nums">{String(index + 1).padStart(2, '0')}</span>
            <h3 class="text-lg font-bold text-ink-950 text-balance">{item.title}</h3>
            <p class="text-sm leading-relaxed text-muted text-pretty">{item.body}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- Benefits -->
  <Section id="benefits" tone="surface">
    <SectionHeading eyebrow={p.benefits.eyebrow} title={p.benefits.title} />

    <div class="mt-14 grid gap-6 sm:grid-cols-2">
      {
        p.benefits.items.map((item) => (
          <article class="flex items-start gap-4 rounded-3xl border border-ink-100 bg-white p-7" data-reveal>
            <span class="mt-0.5 flex size-9 shrink-0 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 ring-1 ring-brand-100">
              <svg viewBox="0 0 20 20" fill="currentColor" class="size-4" aria-hidden="true">
                <path
                  fill-rule="evenodd"
                  d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z"
                  clip-rule="evenodd"
                />
              </svg>
            </span>
            <div class="flex flex-col gap-1.5">
              <h3 class="font-bold text-ink-950 text-balance">{item.title}</h3>
              <p class="text-sm leading-relaxed text-muted text-pretty">{item.body}</p>
            </div>
          </article>
        ))
      }
    </div>
  </Section>

  <!-- Steps -->
  <Section id="steps" tone="white">
    <SectionHeading eyebrow={p.steps.eyebrow} title={p.steps.title} lead={p.steps.lead} />

    <ol class="relative mt-14 grid gap-8 md:grid-cols-3">
      <div
        class="pointer-events-none absolute top-6 right-8 left-8 hidden h-px bg-gradient-to-r from-brand-100 via-brand-300 to-brand-100 md:block"
        aria-hidden="true"
      >
      </div>

      {
        p.steps.items.map((step, index) => (
          <li class="relative flex flex-col gap-4" data-reveal>
            <span class="flex size-12 items-center justify-center rounded-full bg-brand-500 text-lg font-extrabold text-white shadow-[0_10px_24px_-10px_var(--color-brand-500)] ring-8 ring-white">
              {index + 1}
            </span>
            <h3 class="text-lg font-bold text-ink-950 text-balance">{step.title}</h3>
            <p class="leading-relaxed text-muted text-pretty">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- Quote, only when this segment has a testimonial of its own -->
  {
    p.quote.text && (
    <Section tone="ink">
      <figure class="mx-auto flex max-w-3xl flex-col items-center gap-6 text-center" data-reveal>
        <svg viewBox="0 0 24 24" fill="currentColor" class="size-8 text-brand-400" aria-hidden="true">
          <path
            d="M9.5 5C6.5 6.6 4.6 9.5 4.6 12.8c0 3.3 1.9 5.2 4.2 5.2 2 0 3.5-1.5 3.5-3.4 0-1.9-1.4-3.3-3.2-3.3-.3 0-.7 0-.9.1.4-1.7 1.9-3.4 3.9-4.5L9.5 5Zm9 0c-3 1.6-4.9 4.5-4.9 7.8 0 3.3 1.9 5.2 4.2 5.2 2 0 3.5-1.5 3.5-3.4 0-1.9-1.4-3.3-3.2-3.3-.3 0-.7 0-.9.1.4-1.7 1.9-3.4 3.9-4.5L18.5 5Z"
          ></path>
        </svg>
        <blockquote class="text-xl leading-relaxed font-medium text-white text-pretty sm:text-2xl">
          {p.quote.text}
        </blockquote>
        <figcaption class="text-sm text-ink-300">
          <span class="font-bold text-white">{p.quote.author}</span> · {p.quote.role}
        </figcaption>
      </figure>
    </Section>
    )
  }

  <!-- Offer -->
  <Section id="offer" tone="surface">
    <SectionHeading eyebrow={p.offer.eyebrow} title={p.offer.title} lead={p.offer.lead} />

    <div class="mx-auto mt-14 max-w-md">
      <article
        class="relative flex flex-col gap-6 rounded-4xl bg-ink-950 p-8 text-white shadow-lift sm:p-10"
        data-reveal
      >
        <div class="flex flex-col gap-2">
          <h3 class="text-lg font-bold text-white">{plan.name}</h3>
          <p class="text-sm leading-relaxed text-ink-300">{plan.description}</p>
        </div>

        <p class="flex flex-wrap items-baseline gap-x-1.5">
          <span class="text-4xl font-extrabold tracking-tight text-white">{plan.price}</span>
          {plan.period && <span class="text-sm font-semibold text-ink-300">{plan.period}</span>}
        </p>

        <ul class="flex flex-col gap-3 border-t border-white/10 pt-6">
          {
            plan.features.map((feature) => (
              <li class="flex items-start gap-2.5 text-sm text-ink-100">
                <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 size-4 shrink-0 text-brand-400" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z"
                    clip-rule="evenodd"
                  />
                </svg>
                {feature}
              </li>
            ))
          }
        </ul>

        <Button
          href={APP_URLS.register}
          size="lg"
          class="w-full"
          track="cta_signup_click"
          ctaLocation="segment_pricing"
          ctaDestination="register"
          plan={PLAN_SLUGS[planIndex]}
        >
          {t.pricing.cta}
        </Button>
      </article>

      <p class="mt-6 text-center text-sm">
        <a
          href={`${localizePath(locale, '')}#pricing`}
          class="font-semibold text-brand-600 transition hover:text-brand-700"
        >
          {p.backToHome} →
        </a>
      </p>
    </div>
  </Section>

  <!-- FAQ -->
  <Section id="faq" tone="white">
    <SectionHeading eyebrow={p.faq.eyebrow} title={p.faq.title} />

    <div class="mx-auto mt-14 flex max-w-3xl flex-col gap-3">
      {
        p.faq.items.map((item) => (
          <details class="group rounded-3xl border border-ink-100 bg-white px-6 py-5 transition hover:border-brand-200" data-reveal>
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-bold text-ink-950">
              {item.q}
              <svg
                viewBox="0 0 20 20"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                class="size-4 shrink-0 text-brand-500 transition duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                <path d="M10 4v12M4 10h12" />
              </svg>
            </summary>
            <p class="mt-4 leading-relaxed text-muted text-pretty">{item.a}</p>
          </details>
        ))
      }
    </div>
  </Section>

  <!-- Final CTA -->
  <section class="bg-white py-20 sm:py-28">
    <div class="container-page">
      <div
        class="relative overflow-hidden rounded-[2.5rem] bg-ink-950 px-8 py-16 text-center sm:px-16 sm:py-20"
        data-reveal
      >
        <div class="pointer-events-none absolute inset-0" aria-hidden="true">
          <div class="absolute -top-24 left-1/2 size-[30rem] -translate-x-1/2 rounded-full bg-brand-500/25 blur-3xl">
          </div>
        </div>

        <div class="relative mx-auto flex max-w-3xl flex-col items-center gap-6">
          <h2 class="text-h2 font-extrabold text-white text-balance">{p.finalCta.title}</h2>
          <p class="text-lg leading-relaxed text-ink-200 text-pretty">{p.finalCta.lead}</p>
          <div class="mt-2 flex flex-col gap-3 sm:flex-row">
            <Button
              href={APP_URLS.register}
              size="lg"
              track="cta_signup_click"
              ctaLocation="segment_final_cta"
              ctaDestination="register"
            >
              {p.finalCta.cta}
            </Button>
            <Button
              href={`mailto:${CONTACT.email}`}
              variant="secondary"
              size="lg"
              track="contact_request"
              ctaLocation="segment_final_cta"
              ctaDestination="mailto"
            >
              {p.finalCta.secondary}
            </Button>
          </div>
        </div>
      </div>
    </div>
  </section>
