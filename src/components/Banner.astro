---
import { type Locale } from '../i18n/config'
import { useContent } from '../i18n/content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useContent(locale)
---

<!-- Announcement strip. Sits in normal flow above the sticky header, so it scrolls away. -->
<div class="bg-ink-950 text-white">
  <div class="container-page flex items-center justify-center gap-2.5 py-2.5">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="hidden size-4 shrink-0 text-brand-300 sm:block"
      aria-hidden="true"
    >
      <line x1="3" x2="15" y1="22" y2="22"></line>
      <line x1="4" x2="14" y1="9" y2="9"></line>
      <path d="M14 22V4a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v18"></path>
      <path d="M14 13h2a2 2 0 0 1 2 2v2a2 2 0 0 0 2 2a2 2 0 0 0 2-2V9.83a2 2 0 0 0-.59-1.42L18 5"></path>
    </svg>

    <p class="text-center text-xs leading-snug text-ink-300 text-pretty sm:text-sm">
      <span class="font-bold text-white">{t.banner.label}</span>{' '}{t.banner.text}
    </p>
  </div>
</div>
