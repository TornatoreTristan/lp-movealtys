---
import { LOCALES, LOCALE_META, localizePath, type Locale } from '../i18n/config'

interface Props {
  locale: Locale
  class?: string
}

const { locale, class: className } = Astro.props

// Everything after the locale segment, so the switcher preserves the current page.
const rest = Astro.url.pathname.split('/').slice(2).filter(Boolean).join('/')
---

<div class:list={['flex items-center rounded-full bg-ink-50 p-0.5 ring-1 ring-ink-200', className]}>
  {
    LOCALES.map((code) => (
      <a
        href={localizePath(code, rest)}
        hreflang={code}
        lang={code}
        aria-current={code === locale ? 'true' : undefined}
        title={LOCALE_META[code].label}
        class:list={[
          'rounded-full px-2.5 py-1 text-xs font-bold uppercase transition',
          code === locale ? 'bg-white text-ink-950 shadow-sm' : 'text-ink-500 hover:text-ink-950',
        ]}
      >
        {code}
      </a>
    ))
  }
</div>
