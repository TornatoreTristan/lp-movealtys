---
import { type Locale } from '../../i18n/config'
import { useContent } from '../../i18n/content'
import Section from '../ui/Section.astro'
import SectionHeading from '../ui/SectionHeading.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useContent(locale)

// One glyph per feature, in the order defined by the content dictionary.
const icons = [
  'M3 12h3l2-5 3 10 3-8 2 3h5', // cost engine: signal line
  'M5 19a2 2 0 1 0 0-4 2 2 0 0 0 0 4Zm14-10a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM7 17h6a4 4 0 0 0 0-8H9a4 4 0 0 1 0-8h4', // route
  'M4 20V9m5 11V4m5 16v-7m5 7V7', // margin bars
  'M3 17l5-6 4 4 8-9', // trend
]
---

<Section id="features" tone="surface">
  <SectionHeading eyebrow={t.features.eyebrow} title={t.features.title} lead={t.features.lead} />

  <div class="mt-14 grid gap-6 md:grid-cols-2">
    {
      t.features.items.map((item, index) => (
        <article
          class="group flex flex-col gap-5 rounded-4xl border border-ink-100 bg-white p-8 transition duration-300 hover:-translate-y-1 hover:shadow-card"
          data-reveal
        >
          <div class="flex items-center gap-3">
            <span class="flex size-11 items-center justify-center rounded-2xl bg-brand-50 text-brand-600 ring-1 ring-brand-100 transition group-hover:bg-brand-500 group-hover:text-white">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.9"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="size-5"
                aria-hidden="true"
              >
                <path d={icons[index]} />
              </svg>
            </span>
            <span class="rounded-full bg-ink-50 px-3 py-1 text-xs font-bold tracking-wide text-ink-600 uppercase">
              {item.tag}
            </span>
          </div>

          <div class="flex flex-col gap-3">
            <h3 class="text-xl font-bold text-ink-950 text-balance">{item.title}</h3>
            <p class="leading-relaxed text-muted text-pretty">{item.body}</p>
          </div>

          <ul class="mt-auto flex flex-col gap-2.5 border-t border-ink-100 pt-5">
            {item.bullets.map((bullet) => (
              <li class="flex items-start gap-2.5 text-sm font-medium text-ink-800">
                <svg viewBox="0 0 20 20" fill="currentColor" class="mt-0.5 size-4 shrink-0 text-brand-500" aria-hidden="true">
                  <path
                    fill-rule="evenodd"
                    d="M16.7 5.3a1 1 0 0 1 0 1.4l-7.5 7.5a1 1 0 0 1-1.4 0L3.3 9.7a1 1 0 1 1 1.4-1.4l3.8 3.8 6.8-6.8a1 1 0 0 1 1.4 0Z"
                    clip-rule="evenodd"
                  />
                </svg>
                {bullet}
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>
</Section>
