---
import { type Locale } from '../../i18n/config'
import { useContent } from '../../i18n/content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useContent(locale)
---

<section class="border-y border-ink-100 bg-ink-50/60 py-10">
  <div class="container-page grid grid-cols-2 gap-8 lg:grid-cols-4">
    {
      t.stats.map((stat) => (
        <div class="flex flex-col gap-1" data-reveal>
          <span class="text-3xl font-extrabold tracking-tight text-ink-950 sm:text-4xl">{stat.value}</span>
          <span class="text-sm leading-snug text-muted text-pretty">{stat.label}</span>
        </div>
      ))
    }
  </div>
</section>
