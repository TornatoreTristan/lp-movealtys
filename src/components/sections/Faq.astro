---
import { type Locale } from '../../i18n/config'
import { useContent } from '../../i18n/content'
import Section from '../ui/Section.astro'
import SectionHeading from '../ui/SectionHeading.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useContent(locale)
---

<Section id="faq" tone="white">
  <div class="grid gap-12 lg:grid-cols-[0.85fr_1.15fr] lg:gap-16">
    <SectionHeading eyebrow={t.faq.eyebrow} title={t.faq.title} align="left" />

    <div class="flex flex-col divide-y divide-ink-100 border-y border-ink-100">
      {
        t.faq.items.map((item) => (
          <details class="group py-5" name="faq">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-6 text-left text-base font-semibold text-ink-950 transition hover:text-brand-600 [&::-webkit-details-marker]:hidden">
              {item.q}
              <span
                class="flex size-7 shrink-0 items-center justify-center rounded-full bg-ink-50 text-ink-600 transition duration-300 group-open:rotate-45 group-open:bg-brand-500 group-open:text-white"
                aria-hidden="true"
              >
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" class="size-3.5">
                  <path d="M10 4v12M4 10h12" stroke-linecap="round" />
                </svg>
              </span>
            </summary>
            <p class="mt-3 max-w-2xl pr-12 leading-relaxed text-muted text-pretty">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</Section>
