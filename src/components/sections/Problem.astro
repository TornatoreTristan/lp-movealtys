---
import { type Locale } from '../../i18n/config'
import { useContent } from '../../i18n/content'
import Section from '../ui/Section.astro'
import SectionHeading from '../ui/SectionHeading.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useContent(locale)
---

<Section id="problem" tone="white">
  <SectionHeading eyebrow={t.problem.eyebrow} title={t.problem.title} lead={t.problem.lead} />

  <div class="mt-14 grid gap-6 md:grid-cols-3">
    {
      t.problem.items.map((item, index) => (
        <article
          class="relative flex flex-col gap-3 rounded-3xl border border-ink-100 bg-white p-7 transition duration-300 hover:border-brand-200 hover:shadow-card"
          data-reveal
        >
          <span class="text-sm font-black text-brand-200 tabular-nums">
            {String(index + 1).padStart(2, '0')}
          </span>
          <h3 class="text-lg font-bold text-ink-950 text-balance">{item.title}</h3>
          <p class="text-sm leading-relaxed text-muted text-pretty">{item.body}</p>
        </article>
      ))
    }
  </div>
</Section>
