---
import type { HTMLAttributes } from 'astro/types'

interface Props extends Omit<HTMLAttributes<'a'>, 'size'> {
  href: string
  variant?: 'primary' | 'secondary' | 'ghost'
  size?: 'md' | 'lg'
  external?: boolean
  /** Event name pushed on click. Handled by the delegated listener in src/scripts/analytics.ts. */
  track?: string
  ctaLocation?: string
  ctaDestination?: 'register' | 'login' | 'mailto' | 'anchor'
  plan?: string
}

const {
  href,
  variant = 'primary',
  size = 'md',
  external = false,
  track,
  ctaLocation,
  ctaDestination,
  plan,
  class: className,
  ...rest
} = Astro.props

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-semibold whitespace-nowrap transition duration-200 ease-[var(--ease-out-soft)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500'

const variants = {
  primary: 'bg-brand-500 text-white shadow-[0_10px_28px_-10px_var(--color-brand-500)] hover:bg-brand-600 hover:-translate-y-0.5 active:translate-y-0',
  secondary: 'bg-white text-ink-950 ring-1 ring-ink-200 hover:ring-ink-300 hover:bg-ink-50',
  ghost: 'text-ink-800 hover:text-brand-600',
} as const

const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
} as const
---

<a
  href={href}
  class:list={[base, variants[variant], sizes[size], className]}
  data-track={track}
  data-cta-location={ctaLocation}
  data-cta-destination={ctaDestination}
  data-plan={plan}
  {...external ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
  {...rest}
>
  <slot />
</a>
