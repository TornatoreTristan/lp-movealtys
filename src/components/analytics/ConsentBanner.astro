---
/**
 * Cookie consent banner.
 *
 * Refusing is exactly as reachable as accepting — same placement, same size,
 * one click — which is what the CNIL asks for. Wiring lives in
 * `src/scripts/consent.ts`; the panel starts hidden and is revealed only when
 * no answer is on file, or when the footer link reopens it.
 */
import { localizePath, type Locale } from '../../i18n/config'
import { useContent } from '../../i18n/content'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = useContent(locale)

const action =
  'rounded-full px-5 py-2.5 text-sm font-semibold transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500'
---

<div
  data-consent-banner
  hidden
  role="dialog"
  aria-label={t.consent.ariaLabel}
  class="fixed inset-x-4 bottom-4 z-60 mx-auto flex max-w-2xl flex-col gap-4 rounded-3xl border border-ink-200 bg-white p-6 shadow-lift"
>
  <div class="flex flex-col gap-1.5">
    <p class="text-sm font-bold text-ink-950">{t.consent.title}</p>
    <p class="text-sm leading-relaxed text-muted text-pretty">{t.consent.text}</p>
  </div>

  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <a
      href={localizePath(locale, 'privacy')}
      class="text-xs font-semibold text-brand-600 underline underline-offset-4 transition hover:text-brand-700"
    >
      {t.consent.more}
    </a>

    <div class="flex flex-col gap-2 sm:flex-row">
      <button
        type="button"
        data-consent-choice="denied"
        class:list={[action, 'bg-white text-ink-950 ring-1 ring-ink-200 hover:bg-ink-50 hover:ring-ink-300']}
      >
        {t.consent.decline}
      </button>
      <button
        type="button"
        data-consent-choice="granted"
        class:list={[action, 'bg-brand-500 text-white hover:bg-brand-600']}
      >
        {t.consent.accept}
      </button>
    </div>
  </div>
</div>
